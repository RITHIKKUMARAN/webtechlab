# MongoDB Atlas connection string. Replace placeholders locally; never commit real credentials.
MONGODB_URI="mongodb+srv://<db_username>:<db_password>@<cluster-host>/northstar_supply?retryWrites=true&w=majority"

# Generate a random secret of at least 32 characters. Never commit the real value.
JWT_SECRET="replace-with-a-long-random-secret"

# Admin credentials. Sign in with ADMIN_EMAIL and ADMIN_PASSWORD.
ADMIN_USERNAME="Administrator"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password-at-least-12-characters"

# Allowed browser origin.
APP_URL="http://localhost:3000"
